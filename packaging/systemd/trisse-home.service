[Unit]
Description=trisse-home self-hosted start page
Documentation=https://github.com/itadori26/trisse-home/blob/main/docs/native-install.md
Wants=network-online.target
After=network-online.target

[Service]
# The binary sends READY=1 once the HTTP server listens and WATCHDOG=1 pings
# while the database answers (internal/platform/sdnotify); a hung process is
# restarted after WatchdogSec.
Type=notify
NotifyAccess=main
WatchdogSec=60s
User=trisse-home
Group=trisse-home

# The per-installation SECRET_KEY is created on the first start, never at
# build time, so that packages and Raspberry Pi images contain no secret.
# "+" runs this one command with full privileges outside the sandbox below.
ExecStartPre=+/usr/lib/trisse-home/trisse-home-init
# Later files win: a SECRET_KEY set by the admin in trisse-home.env (e.g. when
# moving from Docker) overrides the generated one.
EnvironmentFile=-/etc/trisse-home/secret.env
EnvironmentFile=/etc/trisse-home/trisse-home.env
# Selects the update hint in the settings (the image overrides it).
Environment=INSTALL_METHOD=package
ExecStart=/usr/bin/trisse-home serve

Restart=on-failure
RestartSec=5s
# SHUTDOWN_TIMEOUT (15s) plus a margin.
TimeoutStopSec=20s

StateDirectory=trisse-home
StateDirectoryMode=0750
WorkingDirectory=/var/lib/trisse-home
UMask=0027

# --- Sandbox -----------------------------------------------------------------
# The service only needs to read host metrics (/proc, /sys, statfs), open TCP
# and UDP sockets (HTTP, integrations, Wake-on-LAN) and write its state
# directory. Listening on a port below 1024 (e.g. :80 on the Raspberry Pi
# image) is enabled in a drop-in that adds CAP_NET_BIND_SERVICE.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
