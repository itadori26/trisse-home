#!/bin/sh
# Prepares a native trisse-home installation before the service starts.
# Runs as root via ExecStartPre=+ in trisse-home.service and is idempotent.
#
# It creates the per-installation secrets in /etc/trisse-home/secret.env on
# the first start. They are never part of the package or of a Raspberry Pi
# image, so every device that is installed or flashed gets its own:
#
#   SECRET_KEY   encrypts stored credentials of integrations
#   SETUP_TOKEN  one-time token to create the account; persisted so that the
#                console, the boot partition and trisse-home-setup-token can
#                show it on a headless device (it is useless after the setup)
#
# Values the admin sets in trisse-home.env always win.
# Paths can be overridden for tests through the TRISSE_HOME_* variables.
set -eu

CONF_DIR=${TRISSE_HOME_CONF_DIR:-/etc/trisse-home}
STATE_DIR=${TRISSE_HOME_STATE_DIR:-/var/lib/trisse-home}
SERVICE_GROUP=${TRISSE_HOME_GROUP:-trisse-home}

CONFIG_FILE="$CONF_DIR/trisse-home.env"
SECRET_FILE="$CONF_DIR/secret.env"
# Written by the postrm script when the package is purged but the data is
# kept, so that a later reinstall can still decrypt stored credentials.
SAVED_SECRET="$STATE_DIR/secret.env.purged"

# has VAR FILE: FILE sets VAR to a non-empty value.
has() {
	[ -f "$2" ] && grep -Eq "^[[:space:]]*$1=[^[:space:]]" "$2"
}

random_key() {
	# 32 random bytes, base64 encoded: the format SECRET_KEY expects.
	head -c 32 /dev/urandom | base64 | tr -d '\n'
}

random_token() {
	# 20 characters without look-alikes (0/O, 1/I/L), grouped for typing:
	# about 100 bits of entropy, e.g. K7MP-Q2XA-9HTD-WE4R-ZN6C.
	LC_ALL=C tr -dc 'ABCDEFGHJKMNPQRSTUVWXYZ23456789' </dev/urandom | head -c 20 |
		sed 's/\(....\)/\1-/g; s/-$//'
}

# append_secret LINE...: atomically writes secret.env with its old content plus
# the given lines, already owned by the service group, so the service never
# sees a half-written or unreadable file.
append_secret() {
	tmp=$(mktemp "$SECRET_FILE.XXXXXX")
	trap 'rm -f "$tmp"' EXIT
	if [ -f "$SECRET_FILE" ]; then
		cat "$SECRET_FILE" >"$tmp"
	else
		echo "# Generated on the first start of trisse-home. Keep a copy of SECRET_KEY" >"$tmp"
		echo "# next to your backups: it decrypts the stored credentials." >>"$tmp"
	fi
	printf '%s\n' "$@" >>"$tmp"
	chgrp "$SERVICE_GROUP" "$tmp"
	chmod 0640 "$tmp"
	mv -f "$tmp" "$SECRET_FILE"
	trap - EXIT
}

umask 077

if ! has SECRET_KEY "$CONFIG_FILE" && ! has SECRET_KEY "$SECRET_FILE"; then
	if has SECRET_KEY "$SAVED_SECRET"; then
		append_secret "$(grep -E '^[[:space:]]*SECRET_KEY=' "$SAVED_SECRET" | tail -n 1)"
		rm -f "$SAVED_SECRET"
		echo "trisse-home: restored the SECRET_KEY saved when the package was purged" >&2
	else
		append_secret "SECRET_KEY=$(random_key)"
		echo "trisse-home: generated a new SECRET_KEY in $SECRET_FILE" >&2
	fi
fi

if ! has SETUP_TOKEN "$CONFIG_FILE" && ! has SETUP_TOKEN "$SECRET_FILE"; then
	append_secret "SETUP_TOKEN=$(random_token)"
fi
